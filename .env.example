# Copy to .env and adjust. All app settings are CLIMATE_-prefixed.
CLIMATE_DATABASE_URL=postgresql+psycopg2://climate:climate@localhost:5432/climate
CLIMATE_HAZARD_DIR=data/hazard

# Shared code gating the hosted demo. Empty = open, which is what local dev wants.
# This is not authentication — do not put real client portfolios behind it.
CLIMATE_DEMO_ACCESS_CODE=
